{
  "name": "kohaku",
  "version": "0.1.0",
  "description": "琥珀（kohaku）: vault の md/html を消えない・読める URL の公開ページにする（Cloudflare Workers + D1 + R2）",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply kohaku --local && wrangler dev --local",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "marked": "^18.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "wrangler": "4.131.2"
  }
}
